@using global::Mocha.Models
@inherits HasContext

@code {

    protected override void OnContextChanged()
    {
        if (Context.Loaded)
        {

        }
    }

    private void setPrivacy(bool state)
    {
        if(!Context.Loaded) return;

        var user = Context.User! with { PrivacyEnabled = state };
        User.DB_COLLECTION.Insert(user.Guid, user);
        Context.SetUser(user);
    }

}

<nav class="top custom-navbar @(Context.User == null ? "disabled" : "")">
    <img src="mocha_logo.png" alt="mocha_logo" class="custom-logo"/>

    <nav class="toolbar surface-container-high">

        @if (Context.User?.PrivacyEnabled == false)
        {
            <a @onclick="() => setPrivacy(true)">
                <i>@Icons.VISIBILITY</i>
            </a>
        }
        else
        {
            <a @onclick="() => setPrivacy(false)">
                <i>@Icons.VISIBILITY_OFF</i>
            </a>
        }

        <a href="/settings">
            <i>@Icons.SETTINGS</i>
        </a>

        <img alt="Profile Picture" class="circle" src="@(Context.User?.ProfileImageUrl ?? "default.png") ">
    </nav>
</nav>


<style>
    .custom-navbar {
        grid-column: 1 / -1;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        width: 100%;
        padding: 0.5rem 1rem;
        box-sizing: border-box;
    }

    .custom-logo {
        height: 48px;
        width: auto;
        object-fit: contain;
        padding-left: 20px;
    }
</style>
