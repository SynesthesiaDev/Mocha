@using global::Mocha.Models
@using Synesthesia.Utils.Extensions

@code {

    [Parameter]
    public required MochaTask? TaskToEdit { get; set; }

    [Parameter]
    public required MochaContext Context { get; set; }

    [Parameter]
    public Action<MochaTask?>? Callback { get; set; }

    [Parameter]
    public Func<MochaTask, MochaTask> Append { get; set; } = t => t;

    [Inject]
    private IJSRuntime java8RuntimeEnvironment { get; set; } = null!;

    private readonly bool active = true;

    private string taskTitle = string.Empty;
    private string taskDescription = string.Empty;
    private EnergyLevel? energyLevel;
    private DateOnly? dueDate;
    private bool privacy;

    private ElementReference dateInputRef;

    private void setEnergyLevel(EnergyLevel? level) => energyLevel = level;

    private void createTask()
    {
        if(string.IsNullOrEmpty(taskTitle)) return;

        var taskToEdit = TaskToEdit ?? MochaTask.Empty(Context.User!);

        var editedTask = taskToEdit with
        {
            Title = taskTitle,
            Description = taskDescription,
            DueDate = dueDate,
            EnergyLevel = energyLevel,
            IsPrivacySensitive = privacy
        };


        var finalTask = Append.Invoke(editedTask);
        MochaTask.DATABASE_COLLECTION.Insert(finalTask.Id, finalTask);

        Context.NotifyChanged();
        StateHasChanged();
        Callback?.Invoke(finalTask);
    }

    protected override void OnInitialized()
    {
        if (TaskToEdit != null)
        {
            taskTitle = TaskToEdit.Title;
            taskDescription = TaskToEdit.Description ?? string.Empty;
        }

        dueDate = TaskToEdit?.DueDate;
        energyLevel = TaskToEdit?.EnergyLevel;
    }

    private async Task openDatePicker()
    {
        await java8RuntimeEnvironment.InvokeVoidAsync("showDatePicker", dateInputRef);
    }

    private void setPrivacy(bool state)
    {
        if (!Context.Loaded) return;
        privacy = state;
    }
}

<dialog id="task-modal" class="modal surface-container-high @(active ? "active" : "")">
    <div class="modal-content">

        <TaskTitleLabel @bind-Value="taskTitle"/>

        <TaskDescriptionInput @bind-Value="taskDescription"/>
        @* <div class="field label fill border"> *@
        @*     <textarea class="modal-input" rows="4" @bind="taskDescription"></textarea> *@
        @*     <label class="on-surface-opacity">Description</label> *@
        @* </div> *@

        <br>

        <div class="modal-footer">

            <div class="meta-buttons">
                @* <button class="border on-surface round"> *@
                @*     <Icon Type="expand_more"/> *@
                @*     Project *@
                @* </button> *@

                <div>
                    <button class="border on-surface round">
                        <Icon Type="@Icons.ENERGY"/>
                        @(energyLevel?.GetDisplayNameAttribute() ?? "Energy Level")
                    </button>
                    <menu>
                        @foreach (var level in EnumExtensions.GetEntries<EnergyLevel>())
                        {
                            <li @onclick="() => setEnergyLevel(level)">@level.GetDisplayNameAttribute()</li>
                        }
                        <li>
                            <hr>
                            <hr>
                        </li>
                        <li @onclick="() => setEnergyLevel(null)">Reset</li>
                    </menu>
                </div>

                <button type="button" class="border on-surface round" @onclick="openDatePicker">
                    <Icon Type="calendar_clock"/>
                    @(dueDate?.ToString("MMM d, yyyy") ?? "Due Date")
                </button>
                <input type="date"
                       @ref="dateInputRef"
                       style="position:absolute; width:0; height:0; opacity:0; pointer-events:none;"
                       @bind="dueDate"/>
                @* <button class="meta-btn border round on-surface"> *@
                @*     <Icon Type="event_repeat"/> *@
                @*     Repeat *@
                @* </button> *@
                @if (!privacy)
                {
                    <button class="border on-surface round" @onclick="() => setPrivacy(true)">

                        <Icon Type="@Icons.VISIBILITY"/>
                        <span>Visible</span>
                    </button>
                }
                else
                {
                    <button class="border on-surface round" @onclick="() => setPrivacy(false)">
                        <Icon Type="@Icons.VISIBILITY_OFF"/>
                        <span>Private</span>
                    </button>
                }

            </div>

            @if (TaskToEdit != null)
            {
                <button class="round" @onclick="createTask">
                    <Icon Type="@Icons.EDIT"/>
                    Edit Task
                </button>
            }
            else
            {
                <button class="round" @onclick="createTask">
                    <Icon Type="@Icons.ADD"/>
                    Create Task
                </button>
            }
        </div>
    </div>
</dialog>

<script>
    //BeerCSS picker not workie, we have to write shitscript

    window.showDatePicker = (element) => {
        if (element && typeof element.showPicker === "function") {
            element.showPicker();
        } else if (element) {
            element.focus();
            element.click();
        }
    };

</script>

<style>

    dialog.modal {
        overflow: visible !important;
    }

    dialog.modal .modal-content {
        overflow: visible !important;
    }

    dialog.modal {
        border-radius: 20px;
        width: min(750px, 90vw);
    }

    .modal-input {
        background: #4F4441 !important;
    }

    .input-border {
        border-color: color-mix(in srgb, var(--on-surface) 25%, transparent) !important;
    }

    .modal-input::placeholder, .modal-textarea::placeholder {
        color: #8A8080;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .meta-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .meta-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 14px;
        border-color: #5A5050;
        color: #D0D0D0;
    }

    .meta-btn:hover {
        background-color: #3B3333;
    }

    .create-btn {
        background-color: #B6E87E;
        color: #1C1C1C;
        font-weight: 600;
        padding: 10px 28px;
    }

    .create-btn:hover {
        background-color: #A3D666;
    }
</style>
