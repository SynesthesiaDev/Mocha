@using global::Mocha.Extensions
@using global::Mocha.Models
@using Synesthesia.Utils.Extensions

@code {

    [Parameter]
    public required MochaTask Task { get; set; }

    [Parameter]
    public required MochaContext Context { get; set; }

    [Parameter]
    public required bool IsTaskDumpView { get; set; }

    public bool IsCompleted => Task.Status == MochaTaskStatus.Done;
    public bool IsScheduledForToday => Task.ScheduledDate == Context.Day!.Date;

    [Inject]
    private IJSRuntime java8RuntimeEnvironment { get; set; } = null!;

    private void delete()
    {
        MochaTask.DATABASE_COLLECTION.Delete(Task.Id);
        Context.NotifyChanged();
    }

    private void edit()
    {
        Context.RequestTaskEdit(Task);
    }

    private void changeStatus(MochaTaskStatus status)
    {
        var task = Task with { Status = status };
        MochaTask.DATABASE_COLLECTION.Insert(task.Id, task);
        Context.NotifyChanged();
    }

    private void changeScheduleDate(DateOnly? date)
    {
        var task = Task with { ScheduledDate = date };

        MochaTask.DATABASE_COLLECTION.Insert(task.Id, task);
        Context.NotifyChanged();
    }

    private ElementReference dateInputRef;

    private async Task openDatePicker()
    {
        await java8RuntimeEnvironment.InvokeVoidAsync("showDatePicker", dateInputRef);
    }

    private void onDatePicked(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            changeScheduleDate(null);
        }
        else if (DateOnly.TryParse(value, out var date))
        {
            changeScheduleDate(date);
        }
    }

}

<div class="task @(IsScheduledForToday && IsTaskDumpView ? "today" : "") @(Task.Status == MochaTaskStatus.Done ? "completed" : "")">
    <div class="task-left">
        <p class="title">
            @if (Task.IsPrivacySensitive)
            {
                <span class="privacy on-surface-opacity-75"><Icon Type="@Icons.VISIBILITY_OFF"/></span>

            }
            <b>@Task.Title</b>
        </p>
        @if (Task.Description != null)
        {
            <p class="subtitle">@Task.Description.CutIfTooLong(100)</p>
        }

        <div>
            @* <button class="chip round primary"> *@
            @*     <Icon Type="@Icons.JOURNAL"/> *@
            @*     Journal / Mocha *@
            @* </button> *@
            @* <button class="chip round"> *@
            @*     <Icon Type="@Icons.REPEAT"/> *@
            @*     Repeats Every Day *@
            @* </button> *@

            @if (Task.ScheduledDate != null)
            {
                <button class="chip round primary">
                    <Icon Type="@Icons.CALENDAR_CHECK"/>
                    @Task.ScheduledDate.Value.ToString("MMM d, yyyy")
                </button>
            }

            @if (Task.DueDate != null)
            {
                <button class="chip round on-surface-opacity-75">
                    <Icon Type="@Icons.CALENDAR_DUE"/>
                    @Task.DueDate.Value.ToString("MMM d, yyyy")
                </button>
            }

            @if (Task.EnergyLevel != null)
            {
                <button class="chip round on-surface-opacity-75">
                    <Icon Type="@Icons.ENERGY"/>
                    @Task.EnergyLevel.GetDisplayNameAttribute()
                </button>
            }
        </div>
    </div>

    <div class="task-right">

        <div>
            <button class="square extra fab">
                <Icon Type="@Icons.DOTS"/>
            </button>

            <menu class="no-wrap">
                <li @onclick="edit">
                    <i>@Icons.EDIT</i>
                    <span>Edit</span>
                </li>
                <li @onclick="delete">
                    <i>@Icons.DELETE</i>
                    <span>Delete</span>
                </li>
            </menu>
        </div>

        @if (IsTaskDumpView)
        {
            <div>
                <button class="square extra">
                    <Icon Type="@(Task.ScheduledDate != null ? Icons.CALENDAR_CHECK : Icons.CALENDAR)"/>
                </button>
                <menu class="no-wrap">
                    @if (Task.ScheduledDate == null)
                    {
                        <li @onclick="() => changeScheduleDate(DateTimeOffset.Now.ToAppDay())">
                            <i>@Icons.ADD</i>
                            <span>Today</span>
                        </li>
                    }
                    else
                    {
                        <li @onclick="() => changeScheduleDate(null)">
                            <i>@Icons.REMOVE</i>
                            <span>Unschedule</span>
                        </li>
                    }

                    <li @onclick="openDatePicker">
                        <i>@Icons.CALENDAR</i>
                        <span>Another Date</span>
                    </li>
                </menu>
                <input type="date"
                       @ref="dateInputRef"
                       style="position:absolute; width:0; height:0; opacity:0; pointer-events:none;"
                       @onchange="onDatePicked"
                />
            </div>
        }
        else
        {
            <button class="square extra fab">
                <Icon Type="@Icons.PLAY"/>
            </button>

            <div>
                @if (!IsCompleted)
                {
                    <button class="square extra" @onclick="() => changeStatus(MochaTaskStatus.Done)">
                        <Icon Type="@Icons.CHECK"/>
                    </button>
                }
                else
                {
                    <button class="square extra" @onclick="() => changeStatus(MochaTaskStatus.Todo)">
                        <Icon Type="@Icons.UNDO"/>
                    </button>
                }

                @* <menu class="no-wrap"> *@
                @*     @foreach (var status in EnumExtensions.GetEntries<MochaTaskStatus>()) *@
                @*     { *@
                @*         <li> *@
                @*             $1$ <i>@Icons.EDIT</i> #1# *@
                @*             <span>@status.GetDisplayNameAttribute()</span> *@
                @*         </li> *@
                @*     } *@
                @* </menu> *@

            </div>
        }

    </div>
</div>
<br>


<style>

    .privacy {
        margin-right: 8px;
    }

    .completed {
        opacity: 50%;
    }

    .today {
        border-color: var(--primary);
        border-width: 3px;
        border-style: solid;
    }

    .fab {
        background: #4F4441;
        color: #9C8E89
    }

    .title {
        font-size: 24px;
    }

    .subtitle {
        font-size: 20px;
        opacity: 75%;
        margin-block-start: 0 !important;
    }

    .task {
        display: flex;
        align-items: center;
        justify-content: space-between;
        line-height: 1rem;
        gap: 16px;
        padding: 16px;
        background: #382E2B;
    }

    .task-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .task-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .title {
        font-size: 24px;
        line-height: 1.2;
        margin: 0;
    }

    .chip.round {
        line-height: 1;
        padding: 4px 12px;
        margin-right: 8px;
        /*opacity: 80%;*/
    }
</style>

<script>
    //BeerCSS picker not workie, we have to write shitscript

    window.showDatePicker = (element) => {
        if (element && typeof element.showPicker === "function") {
            element.showPicker();
        } else if (element) {
            element.focus();
            element.click();
        }
    };

</script>
