@using global::Mocha.Models

@code {

    [Parameter]
    public required Day? Day { get; set; }

    private bool active = false;

}

<article class="border focusing @(active ? "primary" : "surface-container-high")">
    <div class="left">
        <p class="hint @(active ? "muted-active" : "")">Currently focusing</p>
        <p class="header @(active ? "active-text" : "")"><b>Make journal use nocturne db</b></p>
    </div>

    <div class="right">
        <span class="timer @(active ? "muted-active" : "")">1h 34m 5s</span>
        <button class="pause-btn @(active ? "pause-btn-active" : "")" aria-label="Pause" @onclick="() => active = !active">
            <i class="extra">play_pause</i>
        </button>
    </div>
</article>

<style>

    .focusing {
        display: flex;
        align-items: center;
        justify-content: space-between;
        line-height: 1rem;
        gap: 16px;
        padding: 25px;
    }

    .header {
        font-size: 32px;
        margin: 0;
    }

    .hint {
        font-size: 20px;
        margin: 0;
    }

    .right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .timer {
        font-size: 40px;
        font-variant-numeric: tabular-nums;
    }

    .active-text {
        color: #243600;
    }

    .muted-active {
        color: #496800;
    }

    .pause-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--primary);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }

    .pause-btn:hover {
        background: var(--primary, color-mix(in srgb, var(--primary) 50%, black));
    }

    .pause-btn-active {
        color: var(--primary);
        background: #496800;
    }

    .pause-btn-active:hover {
        background: #3a5300;
    }

</style>
