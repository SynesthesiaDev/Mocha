@using global::Mocha.Components.Pages.TasksComponents
@using global::Mocha.Models
@using Synesthesia.Utils.Extensions
@rendermode InteractiveServer
@inherits HasContext

@code {

    [Parameter]
    public required bool IsTaskDumpView { get; set; }

    [Parameter]
    public bool ShowCompletedTasksSeparately { get; set; } = true;

    [Parameter]
    public Func<MochaTask, bool> Filter { get; set; } = _ => true;

    private bool modalOpen;

    private List<MochaTask> todoTasks = [];
    private List<MochaTask> completedTasks = [];
    private MochaTask? taskToEdit;

    private MochaProject? projectFilter;
    private string projectChipStyleString = string.Empty;

    protected override void OnContextChanged()
    {
        if (Context.Loaded)
        {
            var tasks = MochaTask.DATABASE_COLLECTION.FindAllWhere(t => t.OwningUserId == Context.User!.Guid && Filter.Invoke(t)).ToList();
            projectFilter = Context.PersistentProjectFilter;

            if (projectFilter != null) tasks = tasks.Filter(t => t.ProjectId == projectFilter.Id);

            if (Context.User!.PrivacyEnabled)
            {
                tasks = tasks.Filter(t => !t.IsPrivacySensitive);
            }

            if (ShowCompletedTasksSeparately)
            {
                todoTasks = tasks.Filter(t => t.Status != MochaTaskStatus.Done);
                completedTasks = tasks.Filter(t => t.Status == MochaTaskStatus.Done);
            }
            else
            {
                todoTasks = tasks;
            }

            taskToEdit = Context.RequestedTaskEdit;
            if (Context.RequestedTaskEdit != null)
            {
                modalOpen = true;
            }

            projectChipStyleString = projectFilter == null ? string.Empty : $"color: {projectFilter.ColorHex} !important; border-color: {projectFilter.ColorHex} !important";
        }
    }

    private void setFilteredProject(MochaProject? project)
    {
        Context.SetPersistentProjectFilter(project);
    }

    private void open()
    {
        modalOpen = true;
    }

    private void close()
    {
        Context.RequestTaskEdit(null);
        modalOpen = false;
    }

    private MochaTask append(MochaTask task)
    {
        if (IsTaskDumpView) return task;
        return task with { ScheduledDate = Context.Day!.Date };
    }
}

<div class="overlay @(modalOpen ? "active" : "")" @onclick="close"></div>

<div class="row">
    <div class="max">
        <h5>Active Tasks (@todoTasks.Count)</h5>
    </div>

    <!-- Project Filter -->
    <div>
        <button class="border on-surface-opacity-75" style="@projectChipStyleString">
            <Icon Type="@Icons.PROJECTS"/>
            @(projectFilter?.Name ?? "Project Filter")
        </button>
        <menu class="no-wrap">
            @if (projectFilter != null)
            {
                <li @onclick="() => setFilteredProject(null)">
                    <i>@Icons.CLOSE</i>
                    <span>Clear</span>
                </li>
            }

            @foreach (var project in Context.User!.FindAllProjects())
            {

                <li @onclick="() => setFilteredProject(project)">
                    <i>@Icons.PROJECTS</i>
                    <span>@project.Name</span>
                </li>
            }
        </menu>
    </div>

    <!-- Add new task -->
    <button class="border on-surface-opacity-75" @onclick="open">
        <Icon Type="@Icons.ADD"/>
        Create
    </button>
</div>
<br>

@foreach (var task in todoTasks)
{
    <TaskDisplay @key="task.Id" IsTaskDumpView="@IsTaskDumpView" Task="task" Context="Context"/>
}

@if (modalOpen)
{
    <TaskEditModal Context="Context" TaskToEdit="taskToEdit" Callback="_ => close()" Append="append"/>
}

<Gap Size="24px"/>

@if (ShowCompletedTasksSeparately)
{
    <div class="row">
        <div class="max">
            <h5>Completed Tasks (@completedTasks.Count)</h5>
        </div>
    </div>
    <br>

    @foreach (var task in completedTasks)
    {
        <TaskDisplay @key="task.Id" IsTaskDumpView="@IsTaskDumpView" Task="task" Context="Context"/>
    }
}
